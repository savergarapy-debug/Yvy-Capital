rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && 'email_verified' in request.auth.token &&
         request.auth.token.email == 'sa.vergara.py@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function staffPath(uid) {
      return /databases/$(database)/documents/staff/$(uid);
    }

    function isStaffActive(uid) {
      return exists(staffPath(uid)) && get(staffPath(uid)).data.get('active', false) == true;
    }

    function isActiveStaff() {
      return isSignedIn() && isStaffActive(request.auth.uid);
    }

    function isStaffAdmin() {
      let uid = request.auth.uid;
      let hasStaff = exists(staffPath(uid));
      return hasStaff
        && get(staffPath(uid)).data.get('active', false) == true
        && get(staffPath(uid)).data.get('role', '') == 'admin';
    }

    function isPlatformAdmin() {
      return isAdmin() || isStaffAdmin();
    }

    function membershipPath(uid) {
      return /databases/$(database)/documents/memberships/$(uid);
    }

    function counterPath(uid) {
      return /databases/$(database)/documents/listingCounters/$(uid);
    }

    function propertyPath(id) {
      return /databases/$(database)/documents/properties/$(id);
    }

    function hasActivePlan(uid, tiers) {
      let hasMem = exists(membershipPath(uid));
      return hasMem
        && get(membershipPath(uid)).data.get('status', '') == 'active'
        && get(membershipPath(uid)).data.get('planTier', 'FREE') in tiers
        && (get(membershipPath(uid)).data.get('expiresAt', null) == null || get(membershipPath(uid)).data.expiresAt > request.time);
    }

    function wasActiveListing(id) {
      return exists(propertyPath(id)) && get(propertyPath(id)).data.status == 'active';
    }

    function willBeActiveListing(id) {
      return existsAfter(propertyPath(id)) && getAfter(propertyPath(id)).data.status == 'active';
    }

    // Valida en el backend el plan y límite de publicaciones activas del asesor (optimizado con let para ≤ 6 reads y ≤ 10 let vars)
    function canAdvisorPublishProperty(propertyId, data) {
      let uid = request.auth.uid;
      let isStaff = exists(staffPath(uid)) && get(staffPath(uid)).data.get('active', false) == true;
      let isPlatAdm = isAdmin() || (isStaff && get(staffPath(uid)).data.get('role', '') == 'admin');

      let memTier = exists(membershipPath(uid))
        && get(membershipPath(uid)).data.get('status', '') == 'active'
        && (get(membershipPath(uid)).data.get('expiresAt', null) == null || get(membershipPath(uid)).data.expiresAt > request.time)
        ? get(membershipPath(uid)).data.get('planTier', 'FREE')
        : 'FREE';

      let canFeature = isStaff || memTier in ['PLAN_INTERMEDIO', 'PLAN_SENIOR'];
      let maxListings = canFeature ? 10 : (memTier == 'PLAN_INICIAL' ? 5 : 0);

      let hasCounter = exists(counterPath(uid));
      let hasAfterCounter = existsAfter(counterPath(uid));
      let afterCounter = hasAfterCounter ? getAfter(counterPath(uid)).data : {};
      let counterInc = hasAfterCounter && afterCounter.get('lastPropertyId', '') == propertyId
        && ((!hasCounter && afterCounter.count == 1) || (hasCounter && afterCounter.count == get(counterPath(uid)).data.get('count', 0) + 1));

      return isPlatAdm || (
        data.verified == false && maxListings > 0 && (
          (data.status == 'active'
            && counterInc
            && hasAfterCounter
            && afterCounter.count <= maxListings
            && (data.featured == false || canFeature)
          ) ||
          (data.status != 'active' && (data.featured == false || canFeature))
        )
      );
    }

    // Valida en el backend la actualización y cambio de estado de propiedades (optimizado con let para ≤ 6 reads y ≤ 10 let vars)
    function canAdvisorUpdateProperty(propertyId, incomingData, existingData) {
      let uid = request.auth.uid;
      let isStaff = exists(staffPath(uid)) && get(staffPath(uid)).data.get('active', false) == true;
      let isPlatAdm = isAdmin() || (isStaff && get(staffPath(uid)).data.get('role', '') == 'admin');

      let memTier = exists(membershipPath(uid))
        && get(membershipPath(uid)).data.get('status', '') == 'active'
        && (get(membershipPath(uid)).data.get('expiresAt', null) == null || get(membershipPath(uid)).data.expiresAt > request.time)
        ? get(membershipPath(uid)).data.get('planTier', 'FREE')
        : 'FREE';

      let canFeature = isStaff || memTier in ['PLAN_INTERMEDIO', 'PLAN_SENIOR'];
      let maxListings = canFeature ? 10 : (memTier == 'PLAN_INICIAL' ? 5 : 0);

      let hasCounter = exists(counterPath(uid));
      let statusChanged = (existingData.status == 'active') != (incomingData.status == 'active');

      let counterValid = !statusChanged || (
        incomingData.status == 'active'
          ? (
              existsAfter(counterPath(uid)) &&
              getAfter(counterPath(uid)).data.get('lastPropertyId', '') == propertyId &&
              ((!hasCounter && getAfter(counterPath(uid)).data.count == 1) || (hasCounter && getAfter(counterPath(uid)).data.count == get(counterPath(uid)).data.get('count', 0) + 1)) &&
              getAfter(counterPath(uid)).data.count <= maxListings
            )
          : (
              hasCounter &&
              existsAfter(counterPath(uid)) &&
              getAfter(counterPath(uid)).data.get('lastPropertyId', '') == propertyId &&
              getAfter(counterPath(uid)).data.count == get(counterPath(uid)).data.get('count', 0) - 1
            )
      );

      return isPlatAdm || (
        existingData.agentId == uid &&
        incomingData.agentId == existingData.agentId &&
        incomingData.createdAt == existingData.createdAt &&
        incomingData.verified == existingData.verified &&
        (incomingData.featured == false || canFeature) &&
        counterValid &&
        incomingData.diff(existingData).affectedKeys().hasOnly([
          'title', 'description', 'operationType', 'propertyType', 'price', 'currency',
          'department', 'city', 'neighborhood', 'address', 'latitude', 'longitude',
          'areaTotalM2', 'areaBuiltM2', 'bedrooms', 'bathrooms', 'parkingSpaces',
          'amenities', 'imageUrls', 'featured', 'status', 'agentName',
          'agentAgency', 'agentWhatsapp', 'viewsCount', 'updatedAt'
        ])
      );
    }

    // Valida en el backend la eliminación de propiedades (optimizado con let para ≤ 4 reads)
    function canAdvisorDeleteProperty(propertyId, existingData) {
      let uid = request.auth.uid;
      let isStaff = exists(staffPath(uid)) && get(staffPath(uid)).data.get('active', false) == true;
      let isPlatAdm = isAdmin() || (isStaff && get(staffPath(uid)).data.get('role', '') == 'admin');

      let hasCounter = exists(counterPath(uid));
      let counterDec = hasCounter
        && existsAfter(counterPath(uid))
        && getAfter(counterPath(uid)).data.get('lastPropertyId', '') == propertyId
        && getAfter(counterPath(uid)).data.count == get(counterPath(uid)).data.get('count', 0) - 1;

      return isPlatAdm || (
        existingData.agentId == uid &&
        (existingData.status != 'active' || counterDec)
      );
    }

    // Valida en el backend que el usuario tenga Membresía Senior activa
    function hasSeniorMembership() {
      let uid = request.auth.uid;
      let isStaff = exists(staffPath(uid)) && get(staffPath(uid)).data.get('active', false) == true;
      let isSenior = exists(membershipPath(uid))
        && get(membershipPath(uid)).data.get('status', '') == 'active'
        && get(membershipPath(uid)).data.get('planTier', 'FREE') == 'PLAN_SENIOR'
        && (get(membershipPath(uid)).data.get('expiresAt', null) == null || get(membershipPath(uid)).data.expiresAt > request.time);
      return isSignedIn() && (isStaff || isSenior);
    }

    // 3. Entity Validation Blueprints
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
             data.preferredCurrency is string && (data.preferredCurrency == 'PYG' || data.preferredCurrency == 'USD') &&
             data.role is string && (data.role == 'CLIENT' || data.role == 'AGENT') &&
             (!('agencyName' in data) || (data.agencyName is string && data.agencyName.size() <= 120)) &&
             data.planTier is string && (
               data.planTier == 'FREE' ||
               data.planTier == 'PLAN_INICIAL' ||
               data.planTier == 'PLAN_INTERMEDIO' ||
               data.planTier == 'PLAN_SENIOR' ||
               data.planTier == 'PRO_MONTHLY' ||
               data.planTier == 'PRO_ANNUAL'
             ) &&
             (!('activeListingsCount' in data) || (data.activeListingsCount is int && data.activeListingsCount >= 0 && data.activeListingsCount <= 10)) &&
             (!('externalAgentMode' in data) || (
               data.externalAgentMode is bool &&
               (!data.externalAgentMode || isActiveStaff() || hasActivePlan(data.userId, ['PLAN_INTERMEDIO', 'PLAN_SENIOR']))
             )) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidProperty(data) {
      return data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 3000 &&
             data.operationType is string && (data.operationType == 'SALE' || data.operationType == 'RENT') &&
             data.propertyType is string && (
               data.propertyType == 'HOUSE' ||
               data.propertyType == 'APARTMENT' ||
               data.propertyType == 'LAND' ||
               data.propertyType == 'OFFICE' ||
               data.propertyType == 'COMMERCIAL' ||
               data.propertyType == 'ESTANCIA'
             ) &&
             (data.price is int || data.price is float) && data.price > 0 &&
             data.currency is string && (data.currency == 'PYG' || data.currency == 'USD') &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
             data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
             data.neighborhood is string && data.neighborhood.size() <= 80 &&
             data.address is string && data.address.size() <= 250 &&
             (data.latitude is int || data.latitude is float) && data.latitude >= -90 && data.latitude <= 90 &&
             (data.longitude is int || data.longitude is float) && data.longitude >= -180 && data.longitude <= 180 &&
             data.areaTotalM2 is int && data.areaTotalM2 >= 0 && data.areaTotalM2 <= 100000000 &&
             data.areaBuiltM2 is int && data.areaBuiltM2 >= 0 && data.areaBuiltM2 <= 10000000 &&
             data.bedrooms is int && data.bedrooms >= 0 && data.bedrooms <= 50 &&
             data.bathrooms is int && data.bathrooms >= 0 && data.bathrooms <= 50 &&
             data.parkingSpaces is int && data.parkingSpaces >= 0 && data.parkingSpaces <= 100 &&
             data.amenities is list && data.amenities.size() <= 30 && (data.amenities.size() == 0 || (data.amenities[0] is string && data.amenities[0].size() <= 120)) &&
             data.imageUrls is list && data.imageUrls.size() <= 20 && (data.imageUrls.size() == 0 || (data.imageUrls[0] is string && data.imageUrls[0].size() <= 2000)) &&
             data.featured is bool &&
             data.status is string && (data.status == 'active' || data.status == 'reserved' || data.status == 'sold' || data.status == 'paused') &&
             data.agentId is string && data.agentId.size() <= 128 &&
             data.agentName is string && data.agentName.size() >= 1 && data.agentName.size() <= 100 &&
             data.agentAgency is string && data.agentAgency.size() <= 120 &&
             data.agentWhatsapp is string && data.agentWhatsapp.size() >= 4 && data.agentWhatsapp.size() <= 40 &&
             data.verified is bool &&
             (!('viewsCount' in data) || (data.viewsCount is int && data.viewsCount >= 0)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPromoVideo(data) {
      return data.propertyId is string && isValidId(data.propertyId) &&
             data.propertyTitle is string && data.propertyTitle.size() >= 2 && data.propertyTitle.size() <= 140 &&
             data.agentId is string && data.agentId == request.auth.uid && data.agentId.size() <= 128 &&
             data.planTierAtCreation is string && data.planTierAtCreation == 'PLAN_SENIOR' &&
             data.generationMode is string && (data.generationMode == 'AI_INTERACTIONS_API' || data.generationMode == 'AUTOMATED_SLIDESHOW') &&
             data.aspectRatio is string && (data.aspectRatio == '9:16' || data.aspectRatio == '16:9') &&
             data.selectedImages is list && data.selectedImages.size() >= 1 && data.selectedImages.size() <= 6 &&
             data.includeBackgroundMusic is bool &&
             data.overlayHeadline is string && data.overlayHeadline.size() <= 160 &&
             data.priceLabel is string && data.priceLabel.size() <= 80 &&
             data.locationLabel is string && data.locationLabel.size() <= 120 &&
             data.highlightsLabel is string && data.highlightsLabel.size() <= 200 &&
             data.localVideoPath is string && data.localVideoPath.size() <= 500 &&
             data.durationSeconds is int && data.durationSeconds >= 3 && data.durationSeconds <= 30 &&
             data.status is string && (data.status == 'READY' || data.status == 'GENERATING') &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidFavoriteItem(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.propertyId is string && isValidId(data.propertyId) &&
             data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
             (data.price is int || data.price is float) && data.price > 0 &&
             data.currency is string && (data.currency == 'PYG' || data.currency == 'USD') &&
             data.operationType is string && (data.operationType == 'SALE' || data.operationType == 'RENT') &&
             data.propertyType is string && data.propertyType.size() <= 40 &&
             data.city is string && data.city.size() >= 2 && data.city.size() <= 80 &&
             data.neighborhood is string && data.neighborhood.size() >= 1 && data.neighborhood.size() <= 80 &&
             data.areaTotalM2 is int && data.areaTotalM2 >= 0 &&
             data.bedrooms is int && data.bedrooms >= 0 &&
             data.bathrooms is int && data.bathrooms >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPropertyInquiry(data) {
      return data.propertyId is string && isValidId(data.propertyId) &&
             data.propertyTitle is string && data.propertyTitle.size() >= 2 && data.propertyTitle.size() <= 140 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() >= 2 && data.userName.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 150 &&
             data.userPhone is string && data.userPhone.size() >= 5 && data.userPhone.size() <= 40 &&
             data.agentId is string && data.agentId.size() >= 1 && data.agentId.size() <= 128 &&
             data.inquiryType is string && (data.inquiryType == 'INFO' || data.inquiryType == 'VISIT' || data.inquiryType == 'AVAILABILITY') &&
             data.preferredDate is string && data.preferredDate.size() <= 80 &&
             data.message is string && data.message.size() >= 3 && data.message.size() <= 1000 &&
             data.status is string && (data.status == 'PENDING' || data.status == 'CONTACTED' || data.status == 'VISIT_SCHEDULED' || data.status == 'CLOSED') &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPropertyReport(data) {
      return data.propertyId is string && isValidId(data.propertyId) &&
             data.propertyTitle is string && data.propertyTitle.size() >= 2 && data.propertyTitle.size() <= 140 &&
             data.reporterId is string && data.reporterId == request.auth.uid && data.reporterId.size() <= 128 &&
             data.reason is string && (
               data.reason == 'FRAUD' ||
               data.reason == 'INACCURATE_PRICE' ||
               data.reason == 'DUPLICATE' ||
               data.reason == 'SOLD_UNAVAILABLE' ||
               data.reason == 'INAPPROPRIATE'
             ) &&
             data.details is string && data.details.size() >= 3 && data.details.size() <= 1000 &&
             data.status is string && (data.status == 'OPEN' || data.status == 'REVIEWED' || data.status == 'DISMISSED') &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 4. Collection Rules

    // A. Perfiles de Usuarios (/users/{userId}) - Estricto aislamiento PII y validación de membresías
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isPlatformAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().planTier == 'FREE' && (!('activeListingsCount' in incoming()) || incoming().activeListingsCount == 0) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'preferredCurrency', 'role', 'planTier', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'phone', 'preferredCurrency', 'role', 'agencyName', 'planTier', 'activeListingsCount', 'externalAgentMode', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) && (
                         isPlatformAdmin() || (
                           request.auth.uid == userId &&
                           incoming().userId == existing().userId &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly([
                             'displayName', 'phone', 'preferredCurrency', 'role',
                             'agencyName', 'externalAgentMode', 'updatedAt'
                           ])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isPlatformAdmin());

      // B. Subcolección de Favoritos (/users/{userId}/favorites/{propertyId})
      match /favorites/{propertyId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(propertyId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(propertyId) &&
                         request.auth.uid == userId &&
                         incoming().propertyId == propertyId &&
                         incoming().keys().hasAll(['userId', 'propertyId', 'title', 'price', 'currency', 'operationType', 'propertyType', 'city', 'neighborhood', 'areaTotalM2', 'bedrooms', 'bathrooms', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'propertyId', 'title', 'price', 'currency', 'operationType', 'propertyType', 'city', 'neighborhood', 'areaTotalM2', 'bedrooms', 'bathrooms', 'createdAt']) &&
                         isValidFavoriteItem(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(propertyId) &&
                         isValidFavoriteItem(incoming()) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().propertyId == existing().propertyId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'price', 'currency']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(propertyId) && request.auth.uid == userId;
      }
    }

    // C. Catálogo de Propiedades (/properties/{propertyId})
    match /properties/{propertyId} {
      allow get: if isSignedIn() && isValidId(propertyId) && (
        resource.data.status == 'active' ||
        resource.data.agentId == request.auth.uid ||
        isPlatformAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.status == 'active' ||
        resource.data.agentId == request.auth.uid ||
        isPlatformAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(propertyId) &&
                       incoming().agentId == request.auth.uid &&
                       canAdvisorPublishProperty(propertyId, incoming()) &&
                       incoming().keys().hasAll([
                         'title', 'description', 'operationType', 'propertyType', 'price', 'currency',
                         'department', 'city', 'neighborhood', 'address', 'latitude', 'longitude',
                         'areaTotalM2', 'areaBuiltM2', 'bedrooms', 'bathrooms', 'parkingSpaces',
                         'amenities', 'imageUrls', 'featured', 'status', 'agentId', 'agentName',
                         'agentAgency', 'agentWhatsapp', 'verified', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'title', 'description', 'operationType', 'propertyType', 'price', 'currency',
                         'department', 'city', 'neighborhood', 'address', 'latitude', 'longitude',
                         'areaTotalM2', 'areaBuiltM2', 'bedrooms', 'bathrooms', 'parkingSpaces',
                         'amenities', 'imageUrls', 'featured', 'status', 'agentId', 'agentName',
                         'agentAgency', 'agentWhatsapp', 'verified', 'viewsCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidProperty(incoming());

      allow update: if isSignedIn() &&
                       isValidId(propertyId) &&
                       isValidProperty(incoming()) && (
                         // 1. Seguimiento de visualizaciones: cualquier usuario autenticado incrementa viewsCount en +1 (0 get/exists)
                         (
                           existing().status == 'active' &&
                           incoming().agentId == existing().agentId &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'updatedAt']) &&
                           incoming().viewsCount == existing().get('viewsCount', 0) + 1
                         ) ||
                         // 2. Modificación o cambio de estado por asesor / admin (≤ 6 get/exists)
                         canAdvisorUpdateProperty(propertyId, incoming(), existing())
                       );

      allow delete: if isSignedIn() && isValidId(propertyId) && canAdvisorDeleteProperty(propertyId, existing());
    }

    // D. Videos Promocionales de Propiedades (/property_videos/{videoId}) - EXCLUSIVO PLAN SENIOR
    match /property_videos/{videoId} {
      allow get: if isSignedIn() && isValidId(videoId) && (
        resource.data.agentId == request.auth.uid ||
        resource.data.status == 'READY' ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.agentId == request.auth.uid ||
        resource.data.status == 'READY' ||
        isAdmin()
      );

      allow create: if hasSeniorMembership() &&
                       isValidId(videoId) &&
                       incoming().agentId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'propertyId', 'propertyTitle', 'agentId', 'planTierAtCreation',
                         'generationMode', 'aspectRatio', 'selectedImages', 'includeBackgroundMusic',
                         'overlayHeadline', 'priceLabel', 'locationLabel', 'highlightsLabel',
                         'localVideoPath', 'durationSeconds', 'status', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'propertyId', 'propertyTitle', 'agentId', 'planTierAtCreation',
                         'generationMode', 'aspectRatio', 'selectedImages', 'includeBackgroundMusic',
                         'overlayHeadline', 'priceLabel', 'locationLabel', 'highlightsLabel',
                         'localVideoPath', 'durationSeconds', 'status', 'createdAt'
                       ]) &&
                       isValidPromoVideo(incoming());

      allow delete: if isSignedIn() && isValidId(videoId) && (existing().agentId == request.auth.uid || isAdmin());
    }

    // E. Consultas y Solicitudes de Visita (/inquiries/{inquiryId})
    match /inquiries/{inquiryId} {
      allow get: if isSignedIn() && isValidId(inquiryId) && (
        resource.data.userId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );

      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.agentId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
                       isValidId(inquiryId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll([
                         'propertyId', 'propertyTitle', 'userId', 'userName', 'userEmail',
                         'userPhone', 'agentId', 'inquiryType', 'preferredDate', 'message',
                         'status', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'propertyId', 'propertyTitle', 'userId', 'userName', 'userEmail',
                         'userPhone', 'agentId', 'inquiryType', 'preferredDate', 'message',
                         'status', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidPropertyInquiry(incoming());

      allow update: if isSignedIn() &&
                       isValidId(inquiryId) &&
                       isValidPropertyInquiry(incoming()) && (
                         isAdmin() || (
                           existing().status != 'CLOSED' &&
                           (existing().userId == request.auth.uid || existing().agentId == request.auth.uid) &&
                           incoming().userId == existing().userId &&
                           incoming().agentId == existing().agentId &&
                           incoming().propertyId == existing().propertyId &&
                           incoming().createdAt == existing().createdAt &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'preferredDate', 'message', 'updatedAt'])
                         )
                       );

      allow delete: if isSignedIn() && isValidId(inquiryId) && (existing().userId == request.auth.uid || isAdmin());
    }

    // F. Denuncias y Moderación de Anuncios (/reports/{reportId})
    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().status == 'OPEN' &&
                       incoming().keys().hasAll(['propertyId', 'propertyTitle', 'reporterId', 'reason', 'details', 'status', 'createdAt']) &&
                       incoming().keys().hasOnly(['propertyId', 'propertyTitle', 'reporterId', 'reason', 'details', 'status', 'createdAt']) &&
                       isValidPropertyReport(incoming());

      allow update: if isSignedIn() && isValidId(reportId) && isValidPropertyReport(incoming()) && isAdmin();
      allow delete: if isSignedIn() && isValidId(reportId) && isAdmin();
    }

    // G. Personal Autorizado de Yvy Capital (/staff/{uid})
    match /staff/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isStaffAdmin() || isAdmin());
      allow list: if isSignedIn() && (isStaffAdmin() || isAdmin());
      allow create, update, delete: if false;
    }

    // H. Insignia Pública de Personal (/publicStaff/{uid})
    match /publicStaff/{uid} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() &&
                               isValidId(uid) &&
                               request.auth.uid == uid &&
                               isActiveStaff() &&
                               incoming().keys().hasAll(['uid', 'name', 'updatedAt']) &&
                               incoming().keys().hasOnly(['uid', 'name', 'updatedAt']) &&
                               incoming().uid == uid &&
                               incoming().name == get(staffPath(uid)).data.name &&
                               incoming().updatedAt == request.time;
      allow delete: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isStaffAdmin() || isAdmin());
    }

    // I. Membresías Asignadas (/memberships/{uid}) - Solo Administradores
    match /memberships/{uid} {
      allow get: if isSignedIn() && isValidId(uid);
      allow list: if isPlatformAdmin();
      allow create, update: if isPlatformAdmin() && isValidId(uid)
        && incoming().keys().hasOnly(['planTier', 'status', 'expiresAt', 'assignedBy', 'updatedAt', 'note'])
        && incoming().planTier in ['FREE', 'PLAN_INICIAL', 'PLAN_INTERMEDIO', 'PLAN_SENIOR', 'PRO_MONTHLY', 'PRO_ANNUAL']
        && incoming().status in ['active', 'expired', 'cancelled']
        && (incoming().expiresAt == null || incoming().expiresAt is timestamp)
        && incoming().assignedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if isPlatformAdmin();
    }

    // J. Contador de Publicaciones Activas (/listingCounters/{uid})
    match /listingCounters/{uid} {
      allow get: if isSignedIn() && isValidId(uid) && (request.auth.uid == uid || isPlatformAdmin());
      allow list: if isPlatformAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
        && incoming().keys().hasOnly(['count', 'lastPropertyId'])
        && incoming().count == 1
        && !wasActiveListing(incoming().lastPropertyId)
        && willBeActiveListing(incoming().lastPropertyId)
        && getAfter(propertyPath(incoming().lastPropertyId)).data.agentId == uid;
      allow update: if isSignedIn() && request.auth.uid == uid
        && incoming().keys().hasOnly(['count', 'lastPropertyId'])
        && (
          (incoming().count == existing().count + 1
            && !wasActiveListing(incoming().lastPropertyId)
            && willBeActiveListing(incoming().lastPropertyId)
            && getAfter(propertyPath(incoming().lastPropertyId)).data.agentId == uid)
          ||
          (incoming().count == existing().count - 1 && incoming().count >= 0
            && wasActiveListing(incoming().lastPropertyId)
            && !willBeActiveListing(incoming().lastPropertyId)
            && get(propertyPath(incoming().lastPropertyId)).data.agentId == uid)
        );
      allow write: if isPlatformAdmin();
    }

    // K. Solicitudes de Planes (/membershipRequests/{requestId})
    match /membershipRequests/{requestId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isSignedIn() && isValidId(requestId)
        && incoming().keys().hasOnly(['userId', 'userEmail', 'userName', 'planTier', 'paymentMethod', 'paymentReference', 'status', 'createdAt'])
        && incoming().userId == request.auth.uid
        && incoming().planTier in ['PLAN_INICIAL', 'PLAN_INTERMEDIO', 'PLAN_SENIOR', 'PRO_MONTHLY', 'PRO_ANNUAL']
        && incoming().paymentMethod is string && incoming().paymentMethod.size() <= 50
        && incoming().paymentReference is string && incoming().paymentReference.size() >= 1 && incoming().paymentReference.size() <= 200
        && incoming().status == 'PENDING'
        && incoming().createdAt == request.time;
      allow update: if isPlatformAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
        && incoming().status in ['APPROVED', 'REJECTED'];
      allow delete: if false;
    }
  }
}
